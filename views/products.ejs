<%- include('partials/header') %>
  <%- include('partials/sidebar') %>

<div class="grid grid-cols-1 sm:grid-cols-3 items-center mb-6 px-4">
  <!-- spacer (balances the right column on >= sm) -->
  <div class="hidden sm:block"></div>

  <!-- perfectly centered logo + title -->
  <h2 class="text-2xl font-bold flex items-center justify-center gap-3 py-2 text-center">
    <img src="https://vbaacjkvrypmnvcmwkwv.supabase.co/storage/v1/object/public/products/images/loader.png"
         alt="Urban Medex Logo"
         class="w-12 h-12 sm:w-14 sm:h-14 rounded-full">
    <span class="leading-tight">Welcome to Admin Dashboard of Urban Medex</span>
  </h2>

  <!-- logout on the right (centered below on mobile) -->
  <div class="justify-self-center sm:justify-self-end mt-2 sm:mt-0">
    <a href="/logout"
       class="inline-block bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
      Logout
    </a>
  </div>
</div>
<div class="flex justify-center mb-6 px-6 relative">
  <form action="/search" method="get" class="w-full max-w-lg flex gap-2 relative">
    <input type="text"
           id="searchInput"
           name="q"
           placeholder="Search products by name..."
           class="flex-1 border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
           autocomplete="off">
    <button type="submit"
            class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
      Search
    </button>
    <!-- Suggestions dropdown -->
    <ul id="suggestions"
        class="absolute left-0 top-full bg-white border rounded mt-1 w-full shadow hidden z-50"></ul>
  </form>
</div>






    <!-- Add Product Form -->
    <form method="POST" action="/products/add" enctype="multipart/form-data"
      class="bg-white shadow-md rounded-xl p-6 mb-6">
      <div class="grid grid-cols-2 gap-4">
        <!-- Product Name -->
        <input type="text" name="name" placeholder="Product Name" class="border p-2 rounded" required>

        <!-- Category Dropdown -->
        <select name="category" class="border p-2 rounded" required>
          <option value="" disabled selected>Select Category</option>
          <option  value="Antiviral And Antibiotics">Antiviral And Antibiotics</option>
          <option value="Kamagra All Range">Kamagra All Range</option>
          <option value="Modafinil and Armodafinil">Modafinil and Armodafinil</option>
          <option value="Hair Loss Treatment">Hair Loss Treatment</option>
          <option value="Pain Killer">Pain Killer</option>
          <option value="Sleeping Pills">Sleeping Pills</option>
          <option value="Skin Creams">Skin Creams</option>
          <option value="Steroids">Steroids</option>
          <option value="Avanafil Tablets">Avanafil Tablets</option>
          <option value="Dapoxetine">Dapoxetine</option>
          <option value="Sildenafil Tablets">Sildenafil Tablets</option>
          <option value="Tadalafil Tabltes">Tadalafil Tabltes</option>
          <option value="Vardenafil Tablets">Vardenafil Tablets</option>
          <option value="Weight-loss">Weight-loss</option>
          <option value="Best Seller">Best Seller</option>
          <option value="OthersMedicine-2">OthersMedicine</option>
        </select>

        <!-- Details -->
        <input type="text" name="details" placeholder="Details" class="border p-2 rounded" required>

        <!-- Image Upload -->
        <input type="file" name="image" accept="image/*" class="border p-2 rounded" required>

        <!-- Description -->
        <textarea name="description" placeholder="Description" class="border p-2 rounded col-span-2"></textarea>
      </div>

      <button type="submit" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Add Product</button>
    </form>

    <!-- Products Table -->
    <div class="bg-white shadow-md rounded-xl p-6">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-blue-600 text-white">
            <th class="p-3 text-left">Name</th>
            <th class="p-3 text-left">Category</th>
            <th class="p-3 text-left">Details</th>
            <th class="p-3 text-left">Description</th>
            <th class="p-3 text-left">Image</th>
            <th class="p-3 text-left">Actions</th>
          </tr>
        </thead>
      <tbody>
  <% products.forEach(product => { %>
    <tr class="border-b hover:bg-gray-100">
      <td class="p-3">
        <%= product.name %>
      </td>
      <td class="p-3">
        <%= product.category %>
      </td>
      <td class="p-3 max-w-xs break-words">
  <% if (product.details) { %>
    <p style="white-space: pre-wrap; margin: 0;"><%= product.details %></p>
  <% } else { %>
    No Details
  <% } %>
</td>

    <td class="p-3 max-w-xs break-words">
  <% if (product.description) { %>
    <p style="white-space: pre-wrap; margin: 0;"><%= product.description %></p>
  <% } else { %>
    No Description
  <% } %>
</td>

      <td class="p-3">
        <% if (product.image) { %>
          <img src="<%= product.image %>" alt="Product Image" class="w-16 h-16 object-cover rounded">
        <% } else { %>
          No Image
        <% } %>
      </td>
      <td class="p-3 flex gap-2">
        <!-- Optional Edit button -->
        <!--
        <form method="POST" action="/products/update/<%= product.id %>" class="inline">
          <input type="hidden" name="name" value="<%= product.name %>">
          <button class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700">Edit</button>
        </form>
        -->
        <a href="/products/delete/<%= product.id %>"
           class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700"
           onclick="return confirm('Are you sure you want to delete this product?');">
           Delete
        </a>
      </td>
    </tr>
  <% }) %>
</tbody>

      </table>
    </div>
<script>
  const searchInput = document.getElementById("searchInput");
  const suggestionsBox = document.getElementById("suggestions");

  searchInput.addEventListener("input", async () => {
    const q = searchInput.value.trim();

    if (!q) {
      suggestionsBox.innerHTML = "";
      suggestionsBox.classList.add("hidden");

      // ✅ Reload all products when cleared
      window.location.href = "/admin_urbanmedex";
      return;
    }

    try {
      // ✅ FIX: Use correct backend route
      const res = await fetch(`/product/api/frontend-search?q=${encodeURIComponent(q)}`);
      const products = await res.json();

      if (!products.length) {
        suggestionsBox.innerHTML = "<li class='p-2 text-gray-500'>No matches</li>";
      } else {
        suggestionsBox.innerHTML = products
          .map(
            (p) => `
              <li class="p-2 hover:bg-gray-100 cursor-pointer"
                  onclick="selectSuggestion('${p.name}')">
                ${p.name}
              </li>`
          )
          .join("");
      }

      suggestionsBox.classList.remove("hidden");
    } catch (err) {
      console.error("❌ Error fetching suggestions:", err);
    }
  });

  function selectSuggestion(name) {
    searchInput.value = name;
    suggestionsBox.innerHTML = "";
    suggestionsBox.classList.add("hidden");

    // ✅ Auto-submit the form when a suggestion is clicked
    searchInput.form.submit();
  }

  // Hide suggestions when clicking outside
  document.addEventListener("click", (e) => {
    if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
      suggestionsBox.innerHTML = "";
      suggestionsBox.classList.add("hidden");
    }
  });
</script>


    <%- include('partials/footer') %>
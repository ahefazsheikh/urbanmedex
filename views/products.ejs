<%- include('partials/header') %>
  <%- include('partials/sidebar') %>

    <h2 class="text-2xl font-bold mb-6">Product Management</h2>

    <!-- Add Product Form -->
    <form method="POST" action="/products/add" enctype="multipart/form-data"
      class="bg-white shadow-md rounded-xl p-6 mb-6">
      <div class="grid grid-cols-2 gap-4">
        <!-- Product Name -->
        <input type="text" name="name" placeholder="Product Name" class="border p-2 rounded" required>

        <!-- Category Dropdown -->
        <select name="category" class="border p-2 rounded" required>
          <option value="" disabled selected>Select Category</option>
          <option  value="Antiviral And Antibiotics">Antiviral And Antibiotics</option>
          <option value="Kamagra All Range">Kamagra All Range</option>
          <option value="Modafinil and Armodafinil">Modafinil and Armodafinil</option>
          <option value="Hair Loss Treatment">Hair Loss Treatment</option>
          <option value="Pain Killer">Pain Killer</option>
          <option value="Sleeping Pills">Sleeping Pills</option>
          <option value="Skin Creams">Skin Creams</option>
          <option value="Steroids">Steroids</option>
          <option value="Avanafil Tablets">Avanafil Tablets</option>
          <option value="Dapoxetine">Dapoxetine</option>
          <option value="Sildenafil Tablets">Sildenafil Tablets</option>
          <option value="Tadalafil Tabltes">Tadalafil Tabltes</option>
          <option value="Vardenafil Tablets">Vardenafil Tablets</option>
          <option value="Weight-loss">Weight-loss</option>
          <option value="OthersMedicine-2">OthersMedicine-2</option>
        </select>

        <!-- Details -->
        <input type="text" name="details" placeholder="Details" class="border p-2 rounded" required>

        <!-- Image Upload -->
        <input type="file" name="image" accept="image/*" class="border p-2 rounded" required>

        <!-- Description -->
        <textarea name="description" placeholder="Description" class="border p-2 rounded col-span-2"></textarea>
      </div>

      <button type="submit" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Add Product</button>
    </form>

    <!-- Products Table -->
    <div class="bg-white shadow-md rounded-xl p-6">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-blue-600 text-white">
            <th class="p-3 text-left">Name</th>
            <th class="p-3 text-left">Category</th>
            <th class="p-3 text-left">Details</th>
            <th class="p-3 text-left">Description</th>
            <th class="p-3 text-left">Image</th>
            <th class="p-3 text-left">Actions</th>
          </tr>
        </thead>
      <tbody>
  <% products.forEach(product => { %>
    <tr class="border-b hover:bg-gray-100">
      <td class="p-3">
        <%= product.name %>
      </td>
      <td class="p-3">
        <%= product.category %>
      </td>
      <td class="p-3">
        <%= product.details %>
      </td>
      <td class="p-3">
        <%= product.description %>
      </td>
      <td class="p-3">
        <% if (product.image) { %>
          <img src="<%= product.image %>" alt="Product Image" class="w-16 h-16 object-cover rounded">
        <% } else { %>
          No Image
        <% } %>
      </td>
      <td class="p-3 flex gap-2">
        <!-- Optional Edit button -->
        <!--
        <form method="POST" action="/products/update/<%= product.id %>" class="inline">
          <input type="hidden" name="name" value="<%= product.name %>">
          <button class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700">Edit</button>
        </form>
        -->
        <a href="/products/delete/<%= product.id %>"
           class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700"
           onclick="return confirm('Are you sure you want to delete this product?');">
           Delete
        </a>
      </td>
    </tr>
  <% }) %>
</tbody>

      </table>
    </div>

    <%- include('partials/footer') %>
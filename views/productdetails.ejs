                                </h1>

                                <% if (product.price) { %>
                                    <h4 class="product__price text-muted">₹<%= product.price %></h4>
                                <% } %>

                                <!-- Main description above tabs -->
                                <div class="product__desc" style="white-space: pre-wrap; word-wrap: break-word;">
  <%= product.description || "No description available." %>
</div>


                                <div class="product__meta-details">
                                    <ul class="list-unstyled mb-30">

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="Medcity - Medical Healthcare HTML5 Template">
    <link href="/assets/images/logo/Logo.png" rel="icon">
    <title>
        <%= product.name %> - Urban Medex
    </title>

    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.1/css/all.css">
    <link rel="stylesheet" href="/assets/css/libraries.css">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body>
    <div class="wrapper">
        <!-- Loader -->
        <div id="preloader">
            <div class="loader">
                <img src="/assets/images/logo/loader.png" alt="Urban Medex Logo" />
            </div>
        </div>

        <!-- ========================= Header =========================== -->
        <header class="header header-layout1">
            <nav class="navbar navbar-expand-lg sticky-navbar">
                <div class="container-fluid">
                    <a class="navbar-brand" href="/index.html">
                        <img src="/assets/images/logo/loader.png" class="logo-light" height="75" width="75"
                            alt="logo" />
                        <img src="/assets/images/logo/loader.png" class="logo-dark" height="75" width="75" alt="logo" />
                    </a>
                    <button class="navbar-toggler" type="button">
                        <span class="menu-lines"><span></span></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNavigation">
                        <ul class="navbar-nav ml-auto">
                            <li class="nav__item"><a href="/index.html" class="nav__item-link">Home</a></li>
                            <li class="nav__item"><a href="/about-us.html" class="nav__item-link">About Us</a></li>
                            <li class="nav__item has-dropdown">
                                <a href="#" data-toggle="dropdown"
                                    class="dropdown-toggle nav__item-link active">Shop</a>
                                <ul class="dropdown-menu">
                                    <li class="nav__item"><a href="/shop.html" class="nav__item-link">Our Products</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav__item"><a href="/contact-us.html" class="nav__item-link">Contacts</a></li>
                            <li class="nav__item"><a href="/faqs.html" class="nav__item-link">FAQs</a></li>
                            <ul class="social-icons list-unstyled mb-0 mr-30">
                                <li>
                                    <a href="https://wa.me/+917350169694" style="background-color: #075e54;"><i
                                            class="fab fa-whatsapp"></i></a>
                                </li>
                                <li>
                                    <a href="https://t.me/918149260174" style="background-color: #26A5E4;"><i
                                            class="fab fa-telegram-plane"></i></a>
                                </li>
                                <li>
                                    <a href="https://www.instagram.com/urbanmedex?igsh=eTI1ZXQ4eWxrMW40"
                                        style="background: linear-gradient(45deg, #feda75, #fa7e1e, #d62976, #962fbf, #4f5bd5);"><i
                                            class="fab fa-instagram"></i></a>
                                </li>
                            </ul>
                        </ul>
                        <button class="close-mobile-menu d-block d-lg-none"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </nav>
        </header>

        <!-- ======================== Product Detail =========================== -->
        <section class="shop pb-40 pt-0 mt-30">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="row product-item-single">
                            <div class="col-sm-6">
                                <div class="product__img">
                                    <img src="<%= product.image || '/assets/images/placeholder.png' %>"
                                        alt="<%= product.name %>" class="zoomin img-fluid" loading="lazy">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <h1 class="product__title">
                                    <%= product.name %>
                                </h1>

                                <% if (product.price) { %>
                                    <h4 class="product__price text-muted">₹<%= product.price %></h4>
                                <% } %>

                                <!-- Main description above tabs -->
                                <div class="product__desc" style="white-space: pre-wrap; word-wrap: break-word;">
  <%= product.description || "No description available." %>
</div>


                                <div class="product__meta-details">
                                    <ul class="list-unstyled mb-30">
                                        <li><span>Category :</span> <span><%= product.category || "General" %></span></li>
                                    </ul>
                                </div>

                                <ul class="social-icons list-unstyled mb-0">
                                    <li><a href="https://wa.me/+917350169694" style="background-color:#075e54;"><i
                                                class="fab fa-whatsapp"></i></a></li>
                                    <li><a href="https://t.me/918149260174" style="background-color:#26A5E4;"><i
                                                class="fab fa-telegram-plane"></i></a></li>
                                    <li><a href="https://www.instagram.com/urbanmedex"
                                            style="background:linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5);"><i
                                                class="fab fa-instagram"></i></a></li>
                                </ul><br>

                                <div class="product__action">
                                   <a href="https://mail.google.com/mail/?view=cm&fs=1&to=worldwideonlinepharmacys@gmail.com&su=Inquiry%20about%20<%= encodeURIComponent(product.name) %>&body=Hello,%20I%20would%20like%20to%20know%20more%20about%20<%= encodeURIComponent(product.name) %>."
   class="btn btn__primary btn__rounded" target="_blank">
   <i class="icon-mail"></i> <span>Inquire Now</span>
</a>

                                </div>
                            </div>
                        </div>

                        <!-- Tabs -->
                        <div class="product__details mt-100">
                            <nav class="nav nav-tabs">
                                <a class="nav__link active" data-toggle="tab" href="#Description">Description</a>
                                <a class="nav__link" data-toggle="tab" href="#Details">Details</a>
                            </nav>
                            <div class="tab-content mb-50">
                              <div class="tab-pane fade show active" id="Description">
  <% if (product.description) { %>
    <div style="white-space: pre-wrap; word-wrap: break-word;">
      <%= product.description %>
    </div>
  <% } else { %>
    <p>No detailed description available.</p>
  <% } %>
</div>

<div class="tab-pane fade" id="Details">
  <% if (product.details) { %>
    <div style="white-space: pre-wrap; word-wrap: break-word;">
      <%= product.details %>
    </div>
  <% } else { %>
    <p>No extra details available.</p>
  <% } %>
</div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <!-- ... rest of your footer code ... -->
        </footer>

        <button id="scrollTopBtn"><i class="fas fa-long-arrow-alt-up"></i></button>
    </div><!-- /.wrapper -->

    <script src="/assets/js/jquery-3.5.1.min.js"></script>
    <script src="/assets/js/plugins.js"></script>
    <script src="/assets/js/main.js"></script>
    <script>
        window.addEventListener('load', function () {
            setTimeout(() => document.getElementById('preloader').classList.add('hide'), 1500);
        });
    </script>
</body>

</html>